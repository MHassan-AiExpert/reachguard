# Mode and safety
MODE=sandbox                    # sandbox | live
LIVE_SEND_ENABLED=false
TIME_ZONE_DEFAULT=UTC
SANDBOX_STEP_DELAY_MINUTES=3    # compresses step delays in sandbox demos

# Postgres
POSTGRES_DB=reachguard
POSTGRES_USER=reachguard
POSTGRES_PASSWORD=change-me

# n8n
N8N_VERSION=pin-me
N8N_ENCRYPTION_KEY=change-me
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/

# rg-tools
RG_TOOLS_API_KEY=change-me
RG_WEBHOOK_SECRET=change-me
RG_PUBLIC_BASE_URL=http://localhost:8080
RG_UNSUBSCRIBE_SECRET=change-me
SENDER_PHYSICAL_ADDRESS=Company name, street, city, country
BOOKING_LINK=https://cal.com/example/intro

# LLM
LLM_FAST_MODEL=google:gemini-2.5-flash
LLM_STRONG_MODEL=google:gemini-2.5-pro
LLM_JUDGE_MODEL=google:gemini-2.5-pro   # prefer a different provider than the writer
LLM_MODE=live                   # live | replay
GEMINI_API_KEY=
OPENAI_API_KEY=                 # optional, for judge diversity
LLM_DAILY_BUDGET_USD=5

# Live adapters (leave empty in sandbox)
VERIFIER_PRIMARY_API_KEY=
ZEROBOUNCE_API_KEY=
SMARTLEAD_API_KEY=
SERPER_API_KEY=
FIRECRAWL_API_KEY=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_APPROVER_CHAT_IDS=     # comma-separated allowlist
TELEGRAM_ALERT_CHAT_ID=

# Optional
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
