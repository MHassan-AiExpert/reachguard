{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reachguard.local/contracts/lead-intake.schema.json",
  "type": "object",
  "required": ["campaign", "email", "company"],
  "additionalProperties": false,
  "properties": {
    "campaign": { "type": "string", "minLength": 1, "maxLength": 80 },
    "email": { "type": "string", "minLength": 1, "maxLength": 254 },
    "first_name": { "type": "string", "maxLength": 80 },
    "last_name": { "type": "string", "maxLength": 80 },
    "title": { "type": "string", "maxLength": 120 },
    "company": { "type": "string", "minLength": 1, "maxLength": 160 },
    "website": { "type": "string", "maxLength": 300 },
    "country": { "type": "string", "pattern": "^[A-Za-z]{2}$" },
    "source": { "type": "string", "maxLength": 60 },
    "source_ref": { "type": "string", "maxLength": 200 },
    "tags": { "type": "array", "maxItems": 10, "items": { "type": "string", "maxLength": 40 } },
    "idempotency_key": { "type": "string", "maxLength": 120 }
  }
}
