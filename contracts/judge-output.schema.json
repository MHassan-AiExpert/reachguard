{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reachguard.local/contracts/judge-output.schema.json",
  "type": "object",
  "required": ["verdict", "claim_checks", "issues", "spam_risk", "confidence"],
  "additionalProperties": false,
  "properties": {
    "verdict": { "enum": ["pass", "revise", "reject"] },
    "claim_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["step", "claim_index", "supported", "reason"],
        "additionalProperties": false,
        "properties": {
          "step": { "type": "integer" },
          "claim_index": { "type": "integer", "minimum": 0 },
          "supported": { "type": "boolean" },
          "reason": { "type": "string", "maxLength": 300 }
        }
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["step", "type", "severity", "detail", "fix"],
        "additionalProperties": false,
        "properties": {
          "step": { "type": "integer" },
          "type": { "enum": ["ungrounded_claim", "hidden_claim", "spam_language", "tone", "length", "cta", "compliance", "other"] },
          "severity": { "enum": ["low", "medium", "high"] },
          "detail": { "type": "string", "maxLength": 300 },
          "fix": { "type": "string", "maxLength": 300 }
        }
      }
    },
    "spam_risk": { "type": "number", "minimum": 0, "maximum": 1 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
  }
}
