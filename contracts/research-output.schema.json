{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reachguard.local/contracts/research-output.schema.json",
  "type": "object",
  "required": ["facts", "evidence_sufficiency", "injection_detected"],
  "additionalProperties": false,
  "properties": {
    "facts": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["fact_type", "claim", "source_url", "snippet", "confidence"],
        "additionalProperties": false,
        "properties": {
          "fact_type": { "enum": ["company_summary", "trigger_event", "tech_stack", "hiring", "pain_point", "product", "other"] },
          "claim": { "type": "string", "minLength": 1, "maxLength": 300 },
          "source_url": { "type": "string", "maxLength": 500 },
          "snippet": { "type": "string", "minLength": 1, "maxLength": 400 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "company": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name_clean": { "type": "string", "maxLength": 160 },
        "industry": { "type": "string", "maxLength": 120 },
        "employee_range": { "type": "string", "maxLength": 40 }
      }
    },
    "evidence_sufficiency": { "enum": ["rich", "adequate", "thin", "none"] },
    "injection_detected": { "type": "boolean" }
  }
}
