{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reachguard.local/contracts/copy-output.schema.json",
  "type": "object",
  "required": ["variant_label", "sequence"],
  "additionalProperties": false,
  "properties": {
    "variant_label": { "type": "string", "maxLength": 40 },
    "sequence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["step", "subject", "body", "claims"],
        "additionalProperties": false,
        "properties": {
          "step": { "type": "integer", "minimum": 1, "maximum": 5 },
          "subject": { "type": ["string", "null"], "maxLength": 80 },
          "body": { "type": "string", "minLength": 1, "maxLength": 1500 },
          "claims": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["text", "evidence_id"],
              "additionalProperties": false,
              "properties": {
                "text": { "type": "string", "maxLength": 300 },
                "evidence_id": { "type": "string", "format": "uuid" }
              }
            }
          }
        }
      }
    }
  }
}
