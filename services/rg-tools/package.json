{
  "name": "rg-tools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/main.js",
    "dev": "tsx watch src/main.ts",
    "test": "vitest run",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "fastify": "5.12.8",
    "ioredis": "6.0.0",
    "jsdom": "^31.0.0",
    "pg": "8.23.1",
    "undici": "^8.12.4",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
