    {
      "id": "5897754c-dd95-5ef5-172b-8673dc04d697",
      "name": "Send evaluate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const s = JSON.parse(JSON.stringify($('Init state').first().json));\nconst r = $json;\nconst code = Number(r.statusCode);\nconst body = r.body || {};\ns.send_status = code;\ns.sent = code === 200 && body.status === 'sent';\n// 409 and 423 are refusals the send route has already handled (suppressed, not sendable, kill switch, capped).\nif (!s.sent && code >= 500) throw new Error('send failed: ' + code + ' ' + JSON.stringify(body).slice(0, 300));\nreturn [{ json: s }];"
      },
      "onError": "continueErrorOutput",
