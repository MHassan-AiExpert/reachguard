    {
      "id": "523a2f0f-4e11-dba6-6c01-6210d8288548",
      "name": "Cancel sequence",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH cx AS (\n  UPDATE sends SET status = 'cancelled', failure = $2 WHERE lead_id = $1::uuid AND status = 'scheduled' RETURNING 1),\nmv AS (\n  SELECT transition_lead(l.id, l.status, 'suppressed'::lead_status, $2, 'WF-08b')\n    FROM leads l WHERE l.id = $1::uuid AND $2 = 'suppressed' AND l.status IN ('queued', 'in_sequence'))\nSELECT (SELECT count(*) FROM cx) AS cancelled, (SELECT count(*) FROM mv) AS suppressed",
        "options": {
          "queryReplacement": "={{ [$json.lead.id, $json.block.reason] }}"
        }
