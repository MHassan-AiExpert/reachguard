    {
      "id": "091ddd8b-53c1-df5a-79b6-2f7b2daf1dda",
      "name": "Pre-send checks",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n  COALESCE((SELECT value FROM settings WHERE key = 'kill_switch'), 'false'::jsonb) = 'true'::jsonb AS kill_switch,\n  is_suppressed($2::citext) AS suppressed,\n  EXISTS (SELECT 1 FROM events WHERE lead_id = $1::uuid AND type IN ('reply', 'unsubscribe', 'bounce_hard', 'complaint')) AS stop_event,\n  NOT EXISTS (SELECT 1 FROM sender_inboxes i JOIN sending_domains d ON d.domain = i.domain\n               WHERE i.status = 'active' AND d.status = 'active') AS domain_inactive,\n  NOT EXISTS (SELECT 1 FROM sender_inboxes i JOIN sending_domains d ON d.domain = i.domain\n               WHERE i.status = 'active' AND d.status = 'active'\n                 AND (SELECT count(*) FROM sends x WHERE x.inbox_id = i.id AND x.status = 'sent'\n                         AND x.sent_at >= date_trunc('day', now())) < i.daily_limit) AS inbox_capped,\n  (SELECT count(*) FROM sends x JOIN leads l ON l.id = x.lead_id\n    WHERE l.campaign_id = $3::uuid AND x.status = 'sent' AND x.sent_at >= date_trunc('day', now()))\n    >= COALESCE((SELECT daily_send_cap FROM campaigns WHERE id = $3::uuid), 0) AS campaign_capped",
        "options": {
          "queryReplacement": "={{ [$json.lead.id, $json.lead.email, $json.lead.campaign_id] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "rg-postgres",
          "name": "RG Postgres"
        }
      },
      "onError": "continueErrorOutput",
      "position": [
        2340,
        160
      ]
    },
    {
      "id": "c17f805e-3bf3-02f5-7759-279e3348a720",
      "name": "Block evaluate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const s = JSON.parse(JSON.stringify($('Init state').first().json));\nconst r = $json;\nfunction firstBlock(c) {\n  const order = [\n    ['kill_switch', 'defer'],\n    ['suppressed', 'cancel'],\n    ['stop_event', 'cancel'],\n    ['domain_inactive', 'defer'],\n    ['inbox_capped', 'defer'],\n    ['campaign_capped', 'defer'],\n  ];\n  for (const [reason, action] of order) if (c[reason] === true) return { reason, action };\n  return null;\n}\ns.block = firstBlock(r);\nreturn [{ json: s }];"
      },
      "onError": "continueErrorOutput",
      "position": [
        2600,
        0
