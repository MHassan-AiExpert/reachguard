    {
      "id": "40b1d0de-50a2-b170-0eea-cb330ca68b6d",
      "name": "Apply overrides",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "function routeReply(out, ruleHit) {\n  if (ruleHit === true) return { next_action: 'suppress', reason: 'unsubscribe_rule' };\n  if (out.unsubscribe_intent === true || out.classification === 'unsubscribe') return { next_action: 'suppress', reason: 'model_unsubscribe' };\n  if (!(Number(out.confidence) >= 0.7)) return { next_action: 'human_review', reason: 'low_confidence' };\n  return { next_action: out.next_action, reason: 'model' };\n}\n// The gateway can answer 429 (budget), 502 (provider) or 422 (invalid output); then there is no model verdict.\nconst out = ($json.body && $json.body.output) || { classification: 'other', confidence: 0, summary: 'Classifier unavailable (HTTP ' + ($json.statusCode ?? '?') + '); read this reply yourself.', suggested_response: null, unsubscribe_intent: false, next_action: 'human_review' };\nconst r = routeReply(out, $('Unpack event').first().json.unsubscribe_rule_hit === true);\nreturn [{ json: { out, next_action: r.next_action, override_reason: r.reason } }];"
      },
      "position": [
        4420,
        0
      ]
    },
