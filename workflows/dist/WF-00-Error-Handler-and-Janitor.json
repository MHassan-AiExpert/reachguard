    {
      "id": "a056dfde-df13-5164-3a29-d2ab84414c0f",
      "name": "Mark janitor alerted",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO settings (key, value) VALUES ('janitor_last_alert', to_jsonb(now()::text))\n       ON CONFLICT (key) DO UPDATE SET value = EXCLUDED.value, updated_at = now()",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "rg-postgres",
          "name": "RG Postgres"
        }
      },
      "position": [
        2340,
        0
      ]
    }
