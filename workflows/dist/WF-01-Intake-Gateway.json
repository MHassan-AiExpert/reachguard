    {
      "id": "b37fd854-5e28-527e-a7aa-6bfd7ee4393c",
      "name": "Parse body",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "\nconst raw = $('Extract request').first().json.raw_body;\nlet body;\ntry { body = JSON.parse(raw); } catch { return [{ json: { ok: false, error: 'invalid_json' } }]; }\nconst bulk = Array.isArray(body);\nconst leads = bulk ? body : [body];\nif (leads.length === 0) return [{ json: { ok: false, error: 'empty_batch' } }];\nif (leads.length > 500) return [{ json: { ok: false, error: 'batch_too_large', max: 500 } }];\nreturn [{ json: { ok: true, bulk, leads } }];\n"
      },
      "position": [
        1040,
        160
      ]
    },
