    {
      "id": "ff74a70f-8f00-0d74-aa7a-4a28a6b9038c",
      "name": "Split leads",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "\nconst { leads, bulk } = $input.first().json;\nreturn leads.map((lead, idx) => ({\n  json: { idx, bulk, lead: lead && typeof lead === 'object' && !Array.isArray(lead) ? lead : {} },\n}));\n"
      },
