    {
      "id": "e6b671af-66b7-e6e7-9374-161548629655",
      "name": "Mark validity",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "\nconst src = $('Split leads').all();\nreturn $input.all().map((r, i) => {\n  const s = src[i].json;\n  const valid = r.json.valid === true;\n  const l = s.lead;\n  return { json: {\n    idx: s.idx, bulk: s.bulk, valid, errors: r.json.errors || [], lead: l,\n    email: valid ? String(l.email).trim().toLowerCase() : '',\n  } };\n});\n"
      },
      "position": [
        2080,
        0
      ]
    },
    {
      "id": "9eb47d0a-8e47-e4dc-8964-8a3cc5a86621",
      "name": "Insert lead",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH c AS (\n  SELECT id FROM campaigns WHERE name = $1 AND status = 'active' AND $14::boolean\n),\nins AS (\n  INSERT INTO leads (campaign_id, idempotency_key, email, first_name, last_name, title, company_raw,\n                     website, country, source, source_ref, tags, raw_payload, status)\n  SELECT c.id,\n         COALESCE(NULLIF($2, ''), encode(digest(lower($1) || '|' || $3::text, 'sha256'), 'hex')),\n         $3::citext, NULLIF($4, ''), NULLIF($5, ''), NULLIF($6, ''), $7, NULLIF($8, ''),\n         NULLIF(upper($9), ''), NULLIF($10, ''), NULLIF($11, ''),\n         ARRAY(SELECT jsonb_array_elements_text($12::jsonb)), $13::jsonb, 'received'\n    FROM c\n   WHERE NOT EXISTS (SELECT 1 FROM leads WHERE email = $3::citext)\n  ON CONFLICT DO NOTHING\n  RETURNING id\n)\nSELECT $15::int AS idx,\n       (SELECT id FROM ins) AS inserted_id,\n       (SELECT id FROM leads WHERE email = $3::citext OR idempotency_key = NULLIF($2, '') LIMIT 1) AS existing_id,\n       EXISTS (SELECT 1 FROM c) AS campaign_found",
        "options": {
          "queryReplacement": "={{ [\n  String($json.lead.campaign ?? ''), String($json.lead.idempotency_key ?? ''), $json.email,\n  String($json.lead.first_name ?? ''), String($json.lead.last_name ?? ''), String($json.lead.title ?? ''),\n  String($json.lead.company ?? ''), String($json.lead.website ?? ''), String($json.lead.country ?? ''),\n  String($json.lead.source ?? ''), String($json.lead.source_ref ?? ''),\n  JSON.stringify(Array.isArray($json.lead.tags) ? $json.lead.tags : []),\n  JSON.stringify($json.lead), $json.valid, $json.idx\n] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "rg-postgres",
          "name": "RG Postgres"
        }
      },
      "position": [
        2340,
        0
      ]
