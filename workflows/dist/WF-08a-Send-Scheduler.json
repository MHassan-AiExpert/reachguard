    {
      "id": "b839245f-c801-e468-57ac-842509159c7d",
      "name": "Plan evaluate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const s = JSON.parse(JSON.stringify($('Inputs evaluate').first().json));\nconst r = $json;\ns.mode = r.mode;\ns.allowed = !(r.mode === 'live' && r.live_send_enabled !== true);\ns.plan = s.steps.map((st, i) => ({ step: st, at: r.times[i].at }));\nreturn [{ json: s }];"
      },
      "onError": "continueErrorOutput",
      "position": [
        3380,
        0
      ]
    },
