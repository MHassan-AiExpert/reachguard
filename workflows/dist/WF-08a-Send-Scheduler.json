    {
      "id": "1c0e70d1-4674-5611-7156-56984d33da7a",
      "name": "Create sends",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH d AS (\n  SELECT id, step FROM drafts\n   WHERE lead_id = $1::uuid AND status = 'approved'\n     AND revision = (SELECT max(revision) FROM drafts WHERE lead_id = $1::uuid AND status = 'approved')),\nins AS (\n  INSERT INTO sends (lead_id, draft_id, step, mode, scheduled_at)\n  SELECT $1::uuid, d.id, d.step, $2, t.at\n    FROM d JOIN jsonb_to_recordset($3::jsonb) AS t(step int, at timestamptz) ON t.step = d.step\n  ON CONFLICT (lead_id, step) DO NOTHING\n  RETURNING 1)\nSELECT transition_lead($1::uuid, 'approved'::lead_status, 'queued'::lead_status, 'sequence scheduled', 'WF-08a') AS transitioned,\n       (SELECT count(*) FROM ins) AS sends_created",
        "options": {
          "queryReplacement": "={{ [$json.lead.id, $json.mode, JSON.stringify($json.plan)] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "rg-postgres",
          "name": "RG Postgres"
        }
      },
      "onError": "continueErrorOutput",
      "position": [
        3900,
        0
      ]
    }
