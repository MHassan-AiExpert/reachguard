    {
      "id": "ac9d38aa-e189-f59a-c3c4-5c368a1d8040",
      "name": "Plan times",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "http://rg-tools:8080/v1/schedule/plan",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ timezone: $json.lead.timezone ?? undefined, country: $json.lead.country ?? undefined, delays: $json.delays }) }}",
        "options": {
