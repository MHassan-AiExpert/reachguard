    {
      "id": "3b55d1d3-8337-7893-d5c4-8c406da44a77",
      "name": "Load send inputs",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT is_suppressed($1::citext) AS suppressed,\n  EXISTS (SELECT 1 FROM sender_inboxes i JOIN sending_domains d ON d.domain = i.domain\n           WHERE i.status = 'active' AND d.status = 'active') AS sender_available,\n  COALESCE((SELECT jsonb_agg(jsonb_build_object('step', q.step, 'delay', q.delay) ORDER BY q.step)\n              FROM (SELECT (x->>'step')::int AS step, COALESCE((x->>'delay_business_days')::int, 0) AS delay\n                      FROM campaigns c, jsonb_array_elements(c.sequence) AS x WHERE c.id = $2::uuid) q), '[]'::jsonb) AS sequence,\n  COALESCE((SELECT jsonb_agg(dr.step ORDER BY dr.step) FROM drafts dr\n             WHERE dr.lead_id = $3::uuid AND dr.status = 'approved'\n               AND dr.revision = (SELECT max(revision) FROM drafts WHERE lead_id = $3::uuid AND status = 'approved')), '[]'::jsonb) AS draft_steps",
        "options": {
          "queryReplacement": "={{ [$json.lead.email, $json.lead.campaign_id, $json.lead.id] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "rg-postgres",
          "name": "RG Postgres"
        }
      },
      "onError": "continueErrorOutput",
      "position": [
        2080,
        160
      ]
    },
    {
      "id": "f4cc76ff-3e59-5c51-8fb3-9d7cad08deea",
      "name": "Inputs evaluate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const s = JSON.parse(JSON.stringify($('Init state').first().json));\nconst r = $json;\ns.suppressed = r.suppressed === true;\ns.steps = r.draft_steps || [];\ns.delays = s.steps.map((st, i) => i === 0 ? 0 : ((r.sequence || []).find((x) => x.step === st) || { delay: 0 }).delay);\n// No usable sender or no approved drafts: leave the lead approved. Its lease expires and it is picked up again.\ns.defer = !s.suppressed && (r.sender_available !== true || s.steps.length === 0);\nreturn [{ json: s }];"
      },
      "onError": "continueErrorOutput",
      "position": [
        2340,
        0
      ]
    },
    {
      "id": "016df2b4-ab0d-dfc6-c7fa-996622f850bf",
