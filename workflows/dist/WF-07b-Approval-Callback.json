      "id": "98bcb0e0-e3b7-49e2-ffcc-c11f796c854d",
      "name": "Load allowlist",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT (SELECT CASE jsonb_typeof(value)\n                          WHEN 'array' THEN (SELECT string_agg(x, ',') FROM jsonb_array_elements_text(value) x)\n                          ELSE value #>> '{}' END\n                     FROM settings WHERE key = 'telegram_approver_chat_ids') AS ids",
        "options": {}
      },
