    {
      "id": "00446130-1cc7-a4b4-22d5-eaca4f00e3dc",
      "name": "Approve",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH a AS (\n  UPDATE approvals SET decision = 'approved', decided_at = now(), decided_by = $2\n   WHERE id = $1::uuid AND decision IS NULL RETURNING lead_id),\ndr AS (UPDATE drafts SET status = 'approved' WHERE lead_id = (SELECT lead_id FROM a) AND status = 'qa_pass' RETURNING 1)\nSELECT transition_lead(a.lead_id, 'pending_approval'::lead_status, 'approved'::lead_status, 'approved by ' || $2, 'WF-07b') AS transitioned,\n       (SELECT count(*) FROM dr) AS drafts_approved\n  FROM a",
        "options": {
          "queryReplacement": "={{ [$('Verify callback').first().json.approval_id, $('Classify update').first().json.decided_by] }}"
        }
