      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const u = $('Classify update').first().json;\nconst c = $json;\nconst sequence = c.drafts.map((x) => x.step === 1\n  ? { step: 1, subject: u.subject !== null ? u.subject : x.subject, body: u.body, claims: [] }\n  : { step: x.step, subject: x.subject, body: x.body, claims: x.claims });\nreturn [{ json: { lead_id: c.lead_id, approval_id: c.id, revision: c.revision, copy: { variant_label: 'human-edit', sequence } } }];"
      },
