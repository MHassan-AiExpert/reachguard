      "typeVersion": 2.5,
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT a.id, a.lead_id, a.decision, l.status,\n  COALESCE((SELECT max(dr.revision) FROM drafts dr WHERE dr.lead_id = a.lead_id), 0) AS revision,\n  COALESCE((SELECT jsonb_agg(jsonb_build_object('step', dr.step, 'subject', dr.subject, 'body', dr.body, 'claims', dr.claims) ORDER BY dr.step)\n              FROM drafts dr WHERE dr.lead_id = a.lead_id AND dr.status = 'qa_pass'\n               AND dr.revision = (SELECT max(revision) FROM drafts WHERE lead_id = a.lead_id AND status = 'qa_pass')), '[]'::jsonb) AS drafts\n  FROM approvals a JOIN leads l ON l.id = a.lead_id WHERE a.id = $1::uuid",
        "options": {
          "queryReplacement": "={{ [$json.approval_id] }}"
        }
      },
      "credentials": {
