      "id": "b55b52ca-5b55-ebec-eafa-2539faf6a4cc",
      "name": "Lead loop",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "position": [
        1560,
        0
      ]
    },
    {
      "id": "0a6e5bde-cb14-dfd1-6471-b76ef9e969b0",
      "name": "Release lead",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT release_lead($1::uuid, $2) AS released",
        "options": {
          "queryReplacement": "={{ [$('Lead loop').first().json.id, (typeof $json.error === \"string\" ? $json.error : JSON.stringify($json.error ?? \"stage failed\")).slice(0, 500)] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "rg-postgres",
          "name": "RG Postgres"
        }
      },
      "position": [
        2080,
        0
      ]
    },
    {
      "id": "9d09e81f-f647-e1bc-8082-a99a9d668adf",
      "name": "End run",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE runs\n          SET status = 'succeeded', ended_at = now(),\n              latency_ms = (extract(epoch FROM now() - started_at) * 1000)::int\n        WHERE id = $1",
        "options": {
          "queryReplacement": "={{ [$('Start run').first().json.run_id] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "rg-postgres",
          "name": "RG Postgres"
        }
      },
      "position": [
        1560,
        160
      ]
    },
    {
      "id": "80bb755f-7b30-0501-0f13-26f1a743497a",
      "name": "Init state",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "return [{ json: { lead: $json, flags: [...($json.flags || [])] } }];"
      },
      "onError": "continueErrorOutput",
      "position": [
        1820,
        0
      ]
    },
    {
      "id": "6ff7036f-18c7-ac9b-ba1c-a6784b28efee",
      "name": "Load inputs",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n  (SELECT icp FROM campaigns WHERE id = $1::uuid) AS icp,\n  COALESCE((SELECT jsonb_agg(jsonb_build_object('id', e.id, 'fact_type', e.fact_type, 'claim', e.claim, 'snippet', e.snippet)\n                              ORDER BY e.confidence DESC)\n              FROM research_evidence e WHERE e.lead_id = $2::uuid), '[]'::jsonb) AS evidence",
        "options": {
          "queryReplacement": "={{ [$json.lead.campaign_id, $json.lead.id] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "rg-postgres",
          "name": "RG Postgres"
        }
      },
      "onError": "continueErrorOutput",
      "position": [
        2080,
        160
      ]
    },
    {
      "id": "832b3f31-846a-1861-3198-da5232be6e5f",
      "name": "Inputs ready",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const s = JSON.parse(JSON.stringify($('Init state').first().json));\nconst r = $json;\ns.icp = r.icp || {}; s.evidence = r.evidence || [];\nreturn [{ json: s }];"
      },
      "onError": "continueErrorOutput",
      "position": [
        2340,
        0
      ]
    },
    {
      "id": "becdab61-4a66-c6bf-ca20-6dd2a0003492",
      "name": "Score ICP",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "http://rg-tools:8080/v1/llm/run",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ agent: \"icp-scorer\", lead_id: $json.lead.id, variables: { icp_json: JSON.stringify($json.icp), title: $json.lead.title ?? \"\", company_clean: $json.lead.company_clean ?? $json.lead.company_raw, country: $json.lead.country ?? \"\", evidence: $json.evidence } }) }}",
        "options": {
          "timeout": 60000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "rg-tools-key",
          "name": "RG Tools Key"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueErrorOutput",
      "position": [
        2600,
        0
      ]
    },
    {
      "id": "103c49d7-60d6-79a1-cf89-031eb25f12ec",
      "name": "Compute tier",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "http://rg-tools:8080/v1/score/tier",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ dimensions: $json.output.dimensions, flags: $(\"Init state\").first().json.flags }) }}",
        "options": {
          "timeout": 60000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "rg-tools-key",
          "name": "RG Tools Key"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueErrorOutput",
      "position": [
        2860,
        0
      ]
    },
    {
      "id": "f38a43a4-2210-bc54-6589-d4abfc18d14a",
      "name": "Decide",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const s = JSON.parse(JSON.stringify($('Inputs ready').first().json));\nconst r = $json;\ns.dimensions = $('Score ICP').first().json.output.dimensions;\ns.score = r.score;\ns.tier = r.tier;\ns.decision = r.tier === 'C'\n  ? { to: 'rejected', reason: 'low_fit' }\n  : { to: 'scored', reason: 'tier ' + r.tier + ' score ' + r.score };\nreturn [{ json: s }];"
      },
      "onError": "continueErrorOutput",
      "position": [
        3120,
        0
      ]
    },
    {
      "id": "134072c3-f8a9-65aa-d227-683fc74e4ec9",
      "name": "Store score",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH upd AS (\n  UPDATE leads SET score = $4::numeric, tier = $5, score_breakdown = $6::jsonb\n   WHERE id = $1::uuid RETURNING id)\nSELECT transition_lead(upd.id, 'researched'::lead_status, $2::lead_status, $3, 'WF-04') AS transitioned FROM upd",
        "options": {
          "queryReplacement": "={{ [$json.lead.id, $json.decision.to, $json.decision.reason, $json.score, $json.tier, JSON.stringify({ dimensions: $json.dimensions })] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "rg-postgres",
          "name": "RG Postgres"
        }
      },
      "onError": "continueErrorOutput",
      "position": [
        3380,
        0
      ]
    }
