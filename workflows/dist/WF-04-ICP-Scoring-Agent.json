    {
      "id": "190f8c6c-0c91-297e-1e5c-306c84d811cd",
      "name": "Run on demand",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "parameters": {
        "inputSource": "passthrough"
      },
      "position": [
        0,
        160
      ]
    },
    {
      "id": "be893f45-d991-c0d1-f9eb-513e844e9bf2",
      "name": "Gate",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n         COALESCE((SELECT value FROM settings WHERE key = 'kill_switch'), 'false'::jsonb) = 'true'::jsonb AS kill_switch,\n         COALESCE((SELECT value FROM settings WHERE key = 'llm_paused'), 'false'::jsonb) = 'true'::jsonb AS llm_paused",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "rg-postgres",
          "name": "RG Postgres"
        }
      },
      "position": [
        260,
        0
      ]
    },
    {
      "id": "67301b10-8c3e-908c-8491-9514aded9350",
      "name": "Stage enabled",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "c-21246a736f6e",
              "leftValue": "={{ !$json.kill_switch && !$json.llm_paused }}",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        }
      },
      "position": [
        520,
        0
      ]
    },
    {
      "id": "761d883a-07b1-7f09-7bd7-8d43457b4784",
      "name": "Start run",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO runs (workflow, execution_id) VALUES ($1, $2) RETURNING id AS run_id",
        "options": {
          "queryReplacement": "={{ [\"WF-04 ICP Scoring Agent\", String($execution.id)] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "rg-postgres",
          "name": "RG Postgres"
        }
      },
      "position": [
        780,
        0
      ]
    },
    {
      "id": "0fe22e7a-b974-b4c0-6902-fb97dafc6ec2",
      "name": "Claim leads",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT * FROM claim_leads('researched'::lead_status, 5, $1)",
        "options": {
          "queryReplacement": "={{ [\"WF-04 ICP Scoring Agent\" + \":\" + $execution.id] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "rg-postgres",
          "name": "RG Postgres"
        }
      },
      "alwaysOutputData": true,
      "position": [
        1040,
        0
      ]
    },
    {
      "id": "18fc1b6b-1d13-cc77-d338-da0a32424397",
      "name": "Leads claimed",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "c-2121246a736f",
              "leftValue": "={{ !!$json.id }}",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        }
      },
      "position": [
        1300,
