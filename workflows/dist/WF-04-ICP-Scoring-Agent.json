{
  "id": "rgwf04",
  "name": "WF-04 ICP Scoring Agent",
  "nodes": [
    {
      "id": "8edc81d8-7b2d-d6e6-a29d-5b5b3a72c668",
      "name": "Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      },
      "position": [
        0,
