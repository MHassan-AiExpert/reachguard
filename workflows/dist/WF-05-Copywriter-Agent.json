    {
      "id": "f0d5ad9e-847a-f21c-e6dc-492e6ff93410",
      "name": "Context ready",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const s = JSON.parse(JSON.stringify($('Init state').first().json));\nconst r = $json;\nconst offer = r.offer || {};\nconst styles = Array.isArray(offer.variant_styles) && offer.variant_styles.length ? offer.variant_styles : ['direct'];\ns.offer = offer;\ns.evidence = r.evidence || [];\ns.steps = Array.isArray(r.sequence) && r.sequence.length ? r.sequence.length : 3;\ns.revision = r.last_revision === null || r.last_revision === undefined ? 0 : Number(r.last_revision) + 1;\ns.variant = s.revision > 0 && r.last_variant ? r.last_variant : styles[Number(r.campaign_draft_leads) % styles.length];\ns.revision_issues = r.revision_issues || [];\nif (s.evidence.length === 0) { s.decision = { to: 'needs_review', reason: 'no_evidence' }; }\nreturn [{ json: s }];"
      },
      "onError": "continueErrorOutput",
