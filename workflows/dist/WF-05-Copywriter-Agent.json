    {
      "id": "37d9efcc-0d85-75ea-d792-5081e157b040",
      "name": "Load context",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT c.offer, c.sequence,\n  COALESCE((SELECT jsonb_agg(jsonb_build_object('id', e.id, 'fact_type', e.fact_type, 'claim', e.claim, 'snippet', e.snippet)\n                              ORDER BY e.confidence DESC)\n              FROM research_evidence e WHERE e.lead_id = $2::uuid), '[]'::jsonb) AS evidence,\n  (SELECT max(revision) FROM drafts WHERE lead_id = $2::uuid) AS last_revision,\n  (SELECT variant FROM drafts WHERE lead_id = $2::uuid ORDER BY revision DESC, created_at DESC LIMIT 1) AS last_variant,\n  COALESCE((SELECT jsonb_agg(issue)\n              FROM drafts dr, jsonb_array_elements(COALESCE(dr.qa_report->'issues', '[]'::jsonb)) AS issue\n             WHERE dr.lead_id = $2::uuid AND dr.status = 'qa_revise'\n               AND dr.revision = (SELECT max(revision) FROM drafts WHERE lead_id = $2::uuid)), '[]'::jsonb) AS revision_issues,\n  (SELECT count(DISTINCT dr.lead_id) FROM drafts dr JOIN leads l ON l.id = dr.lead_id WHERE l.campaign_id = $1::uuid) AS campaign_draft_leads\nFROM campaigns c WHERE c.id = $1::uuid",
        "options": {
          "queryReplacement": "={{ [$json.lead.campaign_id, $json.lead.id] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "rg-postgres",
          "name": "RG Postgres"
