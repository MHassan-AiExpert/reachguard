      "name": "Insert drafts",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH ins AS (\n  INSERT INTO drafts (lead_id, step, variant, revision, subject, body, claims, evidence_ids, status, word_count, shingle_hashes)\n  SELECT $1::uuid, x.step, $4, $5::int, x.subject, x.body, x.claims,\n         ARRAY(SELECT jsonb_array_elements_text(x.evidence_ids))::uuid[], 'generated', x.word_count,\n         CASE WHEN x.step = 1 THEN ARRAY(SELECT jsonb_array_elements_text($7::jsonb))::bigint[] ELSE '{}'::bigint[] END\n    FROM jsonb_to_recordset($6::jsonb) AS x(step int, subject text, body text, claims jsonb, evidence_ids jsonb, word_count int)\n   WHERE $2::text = 'drafted'\n  RETURNING 1)\nSELECT transition_lead($1::uuid, 'scored'::lead_status, $2::lead_status, $3, 'WF-05') AS transitioned,\n       (SELECT count(*) FROM ins) AS drafts_written",
        "options": {
          "queryReplacement": "={{ [$json.lead.id, $json.decision.to, $json.decision.reason, $json.variant ?? \"\", $json.revision ?? 0, JSON.stringify(($json.copy?.sequence ?? []).map((x) => ({ step: x.step, subject: x.subject ?? null, body: x.body, claims: x.claims, evidence_ids: [...new Set(x.claims.map((c) => c.evidence_id))], word_count: x.body.trim().split(/\\s+/).length }))), JSON.stringify($json.shingle_hashes ?? [])] }}"
        }
