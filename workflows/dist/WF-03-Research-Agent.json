    },
    {
      "id": "5695b8b7-eeae-7c01-f97b-a2c8362c0dd1",
      "name": "Pages evaluate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const s = JSON.parse(JSON.stringify($('Site evaluate').first().json));\nconst r = $json;\ns.pages = Array.isArray(r.pages) ? r.pages : [];\nif (s.pages.length === 0) { s.decision = { to: 'needs_review', reason: 'no_evidence' }; }\nreturn [{ json: s }];"
      },
      "onError": "continueErrorOutput",
