    {
      "id": "dcee4e10-e4a1-28f2-d404-e24ae0b8eee2",
      "name": "Site evaluate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const s = JSON.parse(JSON.stringify($('Init state').first().json));\nconst r = $json;\ns.site = String(s.lead.website || r.domain || '');\ns.company_name = r.name_clean || s.lead.company_clean || s.lead.company_raw;\ns.company_domain = String(r.domain || '');\nif (!s.site) { s.decision = { to: 'needs_review', reason: 'no_evidence' }; }\nreturn [{ json: s }];"
      },
      "onError": "continueErrorOutput",
      "position": [
        2340,
