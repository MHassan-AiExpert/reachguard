    {
      "id": "c135e52c-4ef3-4b06-6f0d-209d2fabf0b1",
      "name": "Insert evidence",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH upd AS (\n  UPDATE leads SET flags = ARRAY(SELECT jsonb_array_elements_text($4::jsonb)) WHERE id = $1::uuid RETURNING id, company_id),\nev AS (\n  INSERT INTO research_evidence (lead_id, company_id, fact_type, claim, source_url, snippet, confidence, content_hash)\n  SELECT $1::uuid, (SELECT company_id FROM upd), x.fact_type, x.claim, x.source_url, x.snippet, x.confidence,\n         encode(digest(x.snippet, 'sha256'), 'hex')\n    FROM jsonb_to_recordset($5::jsonb) AS x(fact_type text, claim text, source_url text, snippet text, confidence numeric)\n  RETURNING 1),\nco AS (\n  UPDATE companies c\n     SET industry = COALESCE(NULLIF($6::jsonb->>'industry', ''), c.industry),\n         employee_range = COALESCE(NULLIF($6::jsonb->>'employee_range', ''), c.employee_range)\n   WHERE c.id = (SELECT company_id FROM upd) AND $6::jsonb IS NOT NULL\n  RETURNING 1),\ninj AS (\n  INSERT INTO verification_results (lead_id, check_name, outcome, provider, detail)\n  SELECT $1::uuid, 'injection_scan', 'warn', 'llm', jsonb_build_object('dropped_facts', $7::int)\n   WHERE $8::boolean\n  RETURNING 1)\nSELECT transition_lead(upd.id, 'verified'::lead_status, $2::lead_status, $3, 'WF-03') AS transitioned,\n       (SELECT count(*) FROM ev) AS facts_written\n  FROM upd",
        "options": {
          "queryReplacement": "={{ [$json.lead.id, $json.decision.to, $json.decision.reason, JSON.stringify($json.flags), JSON.stringify($json.facts), JSON.stringify($json.company ?? {}), $json.dropped, $json.injection] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "rg-postgres",
          "name": "RG Postgres"
        }
      },
      "onError": "continueErrorOutput",
      "position": [
        2860,
        160
      ]
    }
