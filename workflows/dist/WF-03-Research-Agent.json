    {
      "id": "84bd4cf6-1c32-eb59-fc2b-548d530c23f5",
      "name": "Ground facts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "http://rg-tools:8080/v1/research/ground",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ facts: $json.output.facts, pages: $(\"Pages evaluate\").first().json.pages }) }}",
        "options": {
