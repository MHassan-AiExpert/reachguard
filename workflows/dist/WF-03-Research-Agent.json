    {
      "id": "2b369b0f-0aaf-d770-6895-af4729d6ad53",
      "name": "Grounding evaluate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const s = JSON.parse(JSON.stringify($('Pages evaluate').first().json));\nconst r = $json;\nconst out = $('Extract facts').first().json.output;\ns.facts = r.kept || [];\ns.dropped = r.dropped_count || 0;\ns.injection = out.injection_detected === true;\ns.company = out.company || null;\nif (s.injection && !s.flags.includes('injection_detected')) s.flags.push('injection_detected');\nconst n = s.facts.length;\ns.sufficiency = n === 0 ? 'none' : n < 3 ? 'thin' : n < 5 ? 'adequate' : 'rich';\nif (s.sufficiency === 'none') { s.decision = { to: 'needs_review', reason: 'no_evidence' }; }\nelse {\n  if (s.sufficiency === 'thin' && !s.flags.includes('thin_evidence')) s.flags.push('thin_evidence');\n  s.decision = { to: 'researched', reason: 'evidence ' + s.sufficiency + (s.dropped ? ' (' + s.dropped + ' ungrounded facts dropped)' : '') };\n}\nreturn [{ json: s }];"
      },
      "onError": "continueErrorOutput",
      "position": [
        4160,
        0
      ]
