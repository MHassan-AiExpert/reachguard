      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "http://rg-tools:8080/v1/research/fetch",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
