    {
      "id": "a85336b2-32d8-9a26-2da3-1ecf957e627b",
      "name": "Demo auto-approve",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH pend AS (SELECT id FROM leads WHERE status = 'pending_approval'),\na AS (\n  UPDATE approvals SET decision = 'approved', decided_at = now(), decided_by = 'demo-runner', reason = 'sandbox demo auto-approve'\n   WHERE lead_id IN (SELECT id FROM pend) AND decision IS NULL RETURNING 1),\ndr AS (\n  UPDATE drafts SET status = 'approved' WHERE lead_id IN (SELECT id FROM pend) AND status = 'qa_pass' RETURNING 1)\nSELECT count(transition_lead(p.id, 'pending_approval'::lead_status, 'approved'::lead_status, 'sandbox demo auto-approve', 'WF-14'))::int AS auto_approved,\n       (SELECT count(*) FROM a)::int AS approvals_closed, (SELECT count(*) FROM dr)::int AS drafts_approved\n  FROM pend p",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "rg-postgres",
          "name": "RG Postgres"
        }
