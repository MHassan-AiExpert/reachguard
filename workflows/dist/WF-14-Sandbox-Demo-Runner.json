      "id": "a737de93-0283-c51c-d9b8-8c0520e72ae7",
      "name": "Post summary",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{ $json.chat_id }}",
        "text": "={{ \"ReachGuard sandbox demo finished\" + (Date.now() > $('Start clock').first().json.deadline ? \" (time cap reached, some leads were still in flight)\" : \"\") + \"\\n\\nLeads by status:\\n\" + ($json.by_status ?? \"none\") + \"\\n\\nHygiene blocks: \" + ($json.hygiene_blocks ?? \"none\") + \"\\nReplies: \" + ($json.reply_classes ?? \"none\") + \"\\nEmails sent (sandbox inbox): \" + $json.emails_sent + \"\\nLLM cost: $\" + $json.llm_cost_usd + \"\\n\\n\" + $json.auto_approved + \" lead(s) were auto-approved by the demo runner in place of a human.\" }}",
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "credentials": {
        "telegramApi": {
          "id": "rg-telegram",
          "name": "RG Telegram"
        }
      },
      "onError": "continueRegularOutput",
      "position": [
