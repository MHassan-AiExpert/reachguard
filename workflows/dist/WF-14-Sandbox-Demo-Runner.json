    {
      "id": "5ad7d6d8-1b17-917d-2e79-bf2731789d52",
      "name": "Funnel summary",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n  (SELECT string_agg(status || ': ' || n, E'\\n' ORDER BY status)\n     FROM (SELECT status::text AS status, count(*) AS n FROM leads GROUP BY status) t) AS by_status,\n  (SELECT string_agg(check_name || ' x' || n, ', ' ORDER BY n DESC)\n     FROM (SELECT check_name, count(*) AS n FROM verification_results WHERE outcome = 'fail' GROUP BY check_name) t) AS hygiene_blocks,\n  (SELECT string_agg(COALESCE(classification, 'unclassified') || ': ' || n, ', ' ORDER BY classification)\n     FROM (SELECT classification, count(*) AS n FROM replies GROUP BY classification) t) AS reply_classes,\n  (SELECT count(*) FROM sends WHERE status = 'sent')::int AS emails_sent,\n  (SELECT count(*) FROM approvals WHERE decided_by = 'demo-runner')::int AS auto_approved,\n  (SELECT COALESCE(sum(cost_usd), 0) FROM llm_calls)::numeric(10,4) AS llm_cost_usd,\n  (SELECT value #>> '{}' FROM settings WHERE key = 'telegram_alert_chat_id') AS chat_id",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "rg-postgres",
          "name": "RG Postgres"
        }
      },
      "position": [
        5200,
        160
      ]
    },
