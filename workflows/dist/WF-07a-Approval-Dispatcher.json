      "id": "23ed8df8-ac86-b5b8-78ab-10962a7062fd",
      "name": "Init state",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "return [{ json: { lead: $json, flags: [...($json.flags || [])] } }];"
      },
      "onError": "continueErrorOutput",
