        "httpHeaderAuth": {
          "id": "rg-tools-key",
          "name": "RG Tools Key"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueErrorOutput",
