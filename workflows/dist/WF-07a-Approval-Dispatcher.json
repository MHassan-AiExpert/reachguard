    {
      "id": "0e551844-b15b-2781-a7de-43150017191e",
      "name": "Compose message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const s = $('Policy').first().json;\nconst sig = $('Sign callbacks').first().json;\nconst l = s.lead;\nconst head = 'Approval needed: tier ' + l.tier + ', score ' + l.score + '\\n' +\n  [l.full_name || l.first_name, l.title].filter(Boolean).join(', ') + ' at ' + (l.company_clean || l.company_raw) + '\\n' +\n  'Reasons: ' + s.reasons.join(', ') + '\\n\\nEvidence:\\n' +\n  s.evidence.slice(0, 5).map((e) => '- ' + e.claim + ' (' + e.url + ')').join('\\n') + '\\n';\nconst body = s.drafts.map((x) => '\\nStep ' + x.step + (x.subject ? ' | Subject: ' + x.subject : '') + '\\n' + x.body).join('\\n');\nconst text = (head + body).slice(0, 3900);\nreturn [{ json: { chat_id: s.chat_id, text, approve: sig.approve, edit: sig.edit, reject: sig.reject } }];"
      },
      "onError": "continueErrorOutput",
      "position": [
        3640,
        0
      ]
    },
