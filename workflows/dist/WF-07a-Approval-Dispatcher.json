    {
      "id": "968af036-d3e4-14df-3c90-f752cebd519a",
      "name": "Create approval",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH a AS (\n  INSERT INTO approvals (id, lead_id, channel) VALUES ($1::uuid, $2::uuid, 'telegram') RETURNING id)\nSELECT transition_lead($2::uuid, 'qa_passed'::lead_status, 'pending_approval'::lead_status, $3, 'WF-07a') AS transitioned,\n       (SELECT id FROM a) AS approval_id",
        "options": {
          "queryReplacement": "={{ [$(\"Mint approval id\").first().json.approval_id, $(\"Policy\").first().json.lead.id, \"approval requested: \" + $(\"Policy\").first().json.reasons.join(\",\")] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "rg-postgres",
          "name": "RG Postgres"
        }
      },
      "onError": "continueErrorOutput",
      "position": [
        3380,
        0
