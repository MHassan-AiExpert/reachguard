    },
    {
      "id": "4661f623-583e-26ac-da74-0be207534302",
      "name": "Auto approve",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH a AS (\n  INSERT INTO approvals (lead_id, channel, decision, decided_at, decided_by, reason)\n  VALUES ($1::uuid, 'policy', 'approved', now(), 'auto_policy', 'auto_policy') RETURNING id),\ndr AS (UPDATE drafts SET status = 'approved' WHERE lead_id = $1::uuid AND status = 'qa_pass' RETURNING 1)\nSELECT transition_lead($1::uuid, 'qa_passed'::lead_status, 'approved'::lead_status, 'auto_policy', 'WF-07a') AS transitioned,\n       (SELECT count(*) FROM dr) AS drafts_approved",
        "options": {
          "queryReplacement": "={{ [$json.lead.id] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "rg-postgres",
          "name": "RG Postgres"
        }
      },
      "onError": "continueErrorOutput",
      "position": [
        2860,
        0
      ]
    },
    {
