    {
      "id": "f1a94d3e-3403-cddd-0910-a9c1e0c5b308",
      "name": "Load approval inputs",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT c.approval_policy,\n  (SELECT dr.qa_report->>'confidence' FROM drafts dr\n    WHERE dr.lead_id = $2::uuid AND dr.status = 'qa_pass'\n    ORDER BY dr.revision DESC, dr.step LIMIT 1)::numeric AS confidence,\n  COALESCE((SELECT jsonb_agg(jsonb_build_object('step', dr.step, 'subject', dr.subject, 'body', dr.body) ORDER BY dr.step)\n              FROM drafts dr WHERE dr.lead_id = $2::uuid AND dr.status = 'qa_pass'\n               AND dr.revision = (SELECT max(revision) FROM drafts WHERE lead_id = $2::uuid AND status = 'qa_pass')), '[]'::jsonb) AS drafts,\n  COALESCE((SELECT jsonb_agg(jsonb_build_object('claim', e.claim, 'url', e.source_url) ORDER BY e.confidence DESC)\n              FROM research_evidence e WHERE e.lead_id = $2::uuid), '[]'::jsonb) AS evidence,\n  (SELECT value #>> '{}' FROM settings WHERE key = 'telegram_approver_chat_ids') AS approver_chat_ids\nFROM campaigns c WHERE c.id = $1::uuid",
        "options": {
          "queryReplacement": "={{ [$json.lead.campaign_id, $json.lead.id] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "rg-postgres",
          "name": "RG Postgres"
        }
      },
      "onError": "continueErrorOutput",
      "position": [
        2080,
        160
      ]
    },
    {
      "id": "908c7cdd-04ba-0da0-3eff-0d2b8a13dbb5",
      "name": "Policy",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const s = JSON.parse(JSON.stringify($('Init state').first().json));\nconst r = $json;\nfunction needsApproval(i) {\n  const reasons = [];\n  if ((i.require_for_tiers || []).includes(i.tier)) reasons.push('tier_' + i.tier);\n  if (!(Number(i.confidence) >= i.below)) reasons.push('low_judge_confidence');\n  if ((i.flags || []).includes('catch_all')) reasons.push('catch_all');\n  return { require: reasons.length > 0, reasons };\n}\nconst policy = r.approval_policy || {};\nconst p = needsApproval({\n  tier: s.lead.tier,\n  flags: s.lead.flags || [],\n  confidence: r.confidence,\n  require_for_tiers: policy.require_for_tiers || [\"A\"],\n  below: 0.7,\n});\ns.require = p.require;\ns.reasons = p.reasons;\ns.drafts = r.drafts || [];\ns.evidence = r.evidence || [];\ns.chat_id = String(r.approver_chat_ids || '').split(',').map((x) => x.trim()).filter(Boolean)[0] || '';\nreturn [{ json: s }];"
      },
      "onError": "continueErrorOutput",
      "position": [
        2340,
        0
      ]
    },
    {
      "id": "9c7ae66f-7a50-45f4-fd12-8fc6889c5ec2",
