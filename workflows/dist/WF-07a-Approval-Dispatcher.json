      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "http://rg-tools:8080/v1/approvals/sign",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ approval_id: $json.approval_id }) }}",
        "options": {
          "timeout": 60000
