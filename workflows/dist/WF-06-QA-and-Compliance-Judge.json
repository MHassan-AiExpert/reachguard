    {
      "id": "3b57775c-95cf-98ef-4578-c57b633f1cd6",
      "name": "QA judge",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "http://rg-tools:8080/v1/llm/run",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ agent: \"qa-judge\", lead_id: $(\"Draft copy\").first().json.lead.id, variables: { spam_risk_max: 0.35, rules_json: \"{\\\"step1_words\\\":[50,110],\\\"followup_words\\\":[30,80],\\\"subject_max_chars\\\":60,\\\"spam_risk_max\\\":0.35}\", evidence: $(\"Draft copy\").first().json.evidence, drafts_json: JSON.stringify($(\"Draft copy\").first().json.copy.sequence) } }) }}",
        "options": {
          "timeout": 60000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "rg-tools-key",
          "name": "RG Tools Key"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueErrorOutput",
      "position": [
        3120,
        0
      ]
    },
    {
      "id": "202b52aa-7f83-bea3-b444-032c0e4f919d",
      "name": "Verdict",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const s = JSON.parse(JSON.stringify($('Draft copy').first().json));\nconst r = $json;\nfunction verdict(j, pre, drafts, revision) {\n  const issues = [...(j.issues || [])];\n  for (const v of (pre.violations || [])) {\n    issues.push({ step: 1, type: 'other', severity: 'high', detail: String(v).slice(0, 300), fix: 'Fix: ' + String(v).slice(0, 280) });\n  }\n  if (!drafts.length) return { to: 'needs_review', reason: 'no_drafts', draft_status: 'qa_reject', issues };\n  const checks = j.claim_checks || [];\n  let unsupported = checks.some((c) => c.supported === false);\n  for (const dr of drafts) {\n    (dr.claims || []).forEach((_, i) => {\n      const c = checks.find((x) => x.step === dr.step && x.claim_index === i);\n      if (!c || c.supported !== true) unsupported = true;\n    });\n  }\n  const high = issues.some((i) => i.severity === 'high');\n  const spam = j.spam_risk > 0.35;\n  if (unsupported && !issues.some((i) => i.type === 'ungrounded_claim')) {\n    issues.push({ step: 1, type: 'ungrounded_claim', severity: 'high', detail: 'A claim is not supported by the cited evidence', fix: 'Remove or rewrite unsupported claims using only the evidence' });\n  }\n  if (spam && !issues.some((i) => i.type === 'spam_language')) {\n    issues.push({ step: 1, type: 'spam_language', severity: 'high', detail: 'Spam risk above the limit', fix: 'Remove hype, pressure and promotional wording' });\n  }\n  if (j.verdict === 'pass' && !unsupported && !high && !spam && pre.ok === true) {\n    return { to: 'qa_passed', reason: 'passed qa', draft_status: 'qa_pass', issues };\n  }\n  if (j.verdict === 'reject') return { to: 'needs_review', reason: 'qa_rejected', draft_status: 'qa_reject', issues };\n  if (revision < 2) return { to: 'scored', reason: 'qa_revise', draft_status: 'qa_revise', issues };\n  return { to: 'needs_review', reason: 'qa_exhausted', draft_status: 'qa_reject', issues };\n}\nconst j = r.output;\nconst pre = $('Precheck').first().json;\nconst v = verdict(j, pre, s.copy.sequence, s.revision);\ns.decision = { to: v.to, reason: v.reason };\ns.draft_status = v.draft_status;\ns.report = { verdict: j.verdict, confidence: j.confidence, spam_risk: j.spam_risk, claim_checks: j.claim_checks, issues: v.issues, precheck_violations: pre.violations || [], revision: s.revision, final: v.to };\ns.spam_risk = j.spam_risk;\nreturn [{ json: s }];"
      },
      "onError": "continueErrorOutput",
      "position": [
        3380,
        0
      ]
    },
    {
      "id": "6f156ea5-934b-9d74-e92f-14e0d7d862ef",
      "name": "Store verdict",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH upd AS (\n  UPDATE drafts SET status = $4, qa_report = $5::jsonb, spam_risk = $6::numeric\n   WHERE lead_id = $1::uuid AND revision = $7::int\n  RETURNING 1)\nSELECT transition_lead($1::uuid, 'drafted'::lead_status, $2::lead_status, $3, 'WF-06') AS transitioned,\n       (SELECT count(*) FROM upd) AS drafts_updated",
        "options": {
          "queryReplacement": "={{ [$json.lead.id, $json.decision.to, $json.decision.reason, $json.draft_status ?? \"qa_reject\", JSON.stringify($json.report ?? {}), $json.spam_risk ?? null, $json.revision ?? 0] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "rg-postgres",
          "name": "RG Postgres"
        }
      },
      "onError": "continueErrorOutput",
      "position": [
        2860,
        160
      ]
    }
