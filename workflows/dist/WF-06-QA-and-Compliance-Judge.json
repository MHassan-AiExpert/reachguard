    {
      "id": "b151fa97-3326-5e1c-f1fd-73507034cb9f",
      "name": "Load drafts",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH r AS (SELECT max(revision) AS rev FROM drafts WHERE lead_id = $1::uuid)\nSELECT (SELECT rev FROM r) AS revision,\n  (SELECT min(variant) FROM drafts WHERE lead_id = $1::uuid AND revision = (SELECT rev FROM r)) AS variant,\n  COALESCE((SELECT jsonb_agg(jsonb_build_object('step', dr.step, 'subject', dr.subject, 'body', dr.body, 'claims', dr.claims) ORDER BY dr.step)\n              FROM drafts dr WHERE dr.lead_id = $1::uuid AND dr.revision = (SELECT rev FROM r)), '[]'::jsonb) AS drafts,\n  COALESCE((SELECT jsonb_agg(jsonb_build_object('id', e.id, 'claim', e.claim, 'snippet', e.snippet))\n              FROM research_evidence e WHERE e.lead_id = $1::uuid), '[]'::jsonb) AS evidence",
        "options": {
          "queryReplacement": "={{ [$json.lead.id] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "rg-postgres",
          "name": "RG Postgres"
        }
      },
      "onError": "continueErrorOutput",
      "position": [
        2080,
        160
      ]
    },
    {
      "id": "f81da3d9-837f-affc-45ca-0f6b05f5fc77",
      "name": "Draft copy",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const s = JSON.parse(JSON.stringify($('Init state').first().json));\nconst r = $json;\ns.revision = Number(r.revision ?? 0);\ns.evidence = r.evidence || [];\ns.copy = { variant_label: r.variant || 'draft', sequence: r.drafts || [] };\nif (s.copy.sequence.length === 0) { s.decision = { to: 'needs_review', reason: 'no_drafts' }; s.draft_status = 'qa_reject'; s.report = {}; }\nreturn [{ json: s }];"
      },
      "onError": "continueErrorOutput",
      "position": [
