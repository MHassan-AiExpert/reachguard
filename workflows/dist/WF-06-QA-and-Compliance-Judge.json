      "name": "Init state",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "return [{ json: { lead: $json, flags: [...($json.flags || [])], decision: null } }];"
